# GitHub Personal Access Token 示例文件
# 使用方法：
#   cp .env.example .env
#   编辑 .env，填入真实 token
#   然后在每次 push 前运行：source .env
#
# .env 文件已加入 .gitignore，不会被提交到仓库。

# GitHub PAT（在 https://github.com/settings/tokens 申请）
GITHUB_TOKEN=ghp_your_token_here

# 配置 git 使用 token（source .env 后运行以下命令即可）：
#   git remote set-url origin https://${GITHUB_TOKEN}@github.com/EmergencerOnEarth/EyeTimeline.git
